# Ellipse — Variables d'environnement (modèle — copier vers .env)

# === Ellipse Cortex (IA native — ORDRE-001 : pas de LLM tiers) ===
ELLIPSE_MODELS_DIR=./models
ELLIPSE_CORTEX_MASTER=${ELLIPSE_MODELS_DIR}/cortex-master-v0
ELLIPSE_GPU_DEVICE=cuda:0

# === Services ===
ORCHESTRATOR_PORT=4400
STUDIO_PORT=4273
GATEWAY_PORT=4480
ORCHESTRATOR_URL=http://localhost:4400
STUDIO_URL=http://localhost:4273
REDIS_URL=redis://localhost:6379

# === PostgreSQL — conteneur externe postgres-ellisphere (port 5435) ===
# pgAdmin : « Ellisphere - PostgreSQL Docker 5435 »
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=ellisphere
POSTGRES_USER=ellisphere
POSTGRES_PASSWORD=changeme

# Si le mot de passe contient *, @, #, etc. — encoder dans DATABASE_URL (* → %2A)
DATABASE_URL=postgresql://ellisphere:changeme@localhost:5435/ellisphere

UPLOAD_DIR=./uploads
GENERATED_DIR=./generated

# === Stockage assets S3 (Phase 2+) ===
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ellipse
S3_SECRET_KEY=ellipse_dev
S3_BUCKET=ellipse-assets

# === Pipeline ML local (Phase 2+) ===
COMFYUI_URL=http://localhost:8188

# === App ===
NODE_ENV=development
LOG_LEVEL=info
