# Ellipse — Variables d'environnement (modèle — copier vers .env)

# === Ellipse Cortex (IA native — ORDRE-001 : pas de LLM tiers) ===
ELLIPSE_MODELS_DIR=./models
ELLIPSE_CORTEX_MASTER=${ELLIPSE_MODELS_DIR}/cortex-master-v0
ELLIPSE_GPU_DEVICE=cuda:0

# === Services ===
ORCHESTRATOR_PORT=4400
STUDIO_PORT=4273
GATEWAY_PORT=4480
ORCHESTRATOR_URL=http://localhost:4400
STUDIO_URL=http://localhost:4273
REDIS_URL=redis://localhost:6379

# === PostgreSQL — conteneur externe postgres-ellisphere (port 5435) ===
# pgAdmin : « Ellisphere - PostgreSQL Docker 5435 »
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=ellisphere
POSTGRES_USER=ellisphere
POSTGRES_PASSWORD=changeme

# Si le mot de passe contient *, @, #, etc. — encoder dans DATABASE_URL (* → %2A)
DATABASE_URL=postgresql://ellisphere:changeme@localhost:5435/ellisphere

UPLOAD_DIR=./uploads
GENERATED_DIR=./generated

# === Stockage assets S3 (Phase 2+) ===
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ellipse
S3_SECRET_KEY=ellipse_dev
S3_BUCKET=ellipse-assets

# === Pipeline ML local (Phase 2+) ===
COMFYUI_URL=http://localhost:8188

# === App ===
NODE_ENV=development
LOG_LEVEL=info

# === FORGE — backends génératifs (priorité auto : comfyui > fal > pollinations) ===
# ComfyUI local/distant (GPU) : img2img sur planches, LoRA d'identité, ControlNet
COMFYUI_URL=
FORGE_SDXL_CKPT=sd_xl_base_1.0.safetensors
# fal.ai — serverless payant premium + img2img sans GPU (https://fal.ai/dashboard/keys)
FAL_KEY=
FORGE_FAL_MODEL=fal-ai/flux/schnell
# Replicate — alternative serverless (https://replicate.com/account/api-tokens)
REPLICATE_API_TOKEN=
# Forcer un backend : pollinations | comfyui | fal
FORGE_BACKEND=
# Couper la preview forge dans la production autonome
ELLIPSE_FORGE_PREVIEW=

# === FORGE — cognition (design GDD riche + itération en langage libre) ===
ANTHROPIC_API_KEY=
FORGE_DESIGN_MODEL=claude-sonnet-5
OLLAMA_URL=http://127.0.0.1:11434

# === GPU cloud & modèles ===
RUNPOD_API_KEY=
HUGGINGFACE_TOKEN=

# === Audio premium (voix narration + SFX ; sinon WebAudio procédural) ===
ELEVENLABS_API_KEY=

# === LiveOps / télémétrie / publication ===
PLAYFAB_TITLE_ID=
PLAYFAB_DEV_SECRET_KEY=
FIREBASE_CONFIG=
GAMEANALYTICS_GAME_KEY=
GAMEANALYTICS_SECRET_KEY=
UNITY_REMOTE_CONFIG_ENVIRONMENT_ID=
SENTRY_DSN=
BUTLER_API_KEY=
