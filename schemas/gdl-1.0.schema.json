{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ellipse.dev/schemas/gdl-1.0.schema.json",
  "title": "Ellipse GDL 1.0 — Game Definition Language",
  "description": "Définition COMPLÈTE d'un jeu 2D/2,5D exécutable par le runtime générique de la Forge. Le jeu est de la donnée : aucun code par titre.",
  "type": "object",
  "required": ["gdl", "id", "title", "genre", "world", "entities", "levels"],
  "properties": {
    "gdl": { "enum": ["1.0", "1.1"] },
    "story": {
      "type": "object",
      "description": "1.1 — récit : intro, beats de victoire par niveau, outro. beat = {speaker, text, portrait?}",
      "properties": {
        "intro": { "type": "array", "items": { "$ref": "#/$defs/beat" } },
        "levels": { "type": "object", "additionalProperties": { "type": "object", "properties": { "victory": { "type": "array", "items": { "$ref": "#/$defs/beat" } } } } },
        "outro": { "type": "array", "items": { "$ref": "#/$defs/beat" } }
      }
    },
    "relics": {
      "type": "array",
      "description": "1.1 — objets de progression choisis entre les niveaux",
      "items": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "desc": { "type": "string" }, "effect": { "type": "object", "properties": { "speedMul": { "type": "number" }, "jumpMul": { "type": "number" }, "damageAdd": { "type": "number" }, "hpAdd": { "type": "number" } } } } }
    },
    "map": {
      "type": "object",
      "description": "1.1 — carte-monde : nœuds positionnés (fractions viewport)",
      "properties": { "title": { "type": "string" }, "nodes": { "type": "array", "items": { "type": "object", "properties": { "level": { "type": "string" }, "x": { "type": "number" }, "y": { "type": "number" }, "name": { "type": "string" } } } } }
    },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "genre": { "enum": ["sidescroller", "vertical-arena"] },
    "seed": { "type": "integer" },
    "palette": { "type": "array", "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } },
    "world": {
      "type": "object",
      "required": ["viewport"],
      "properties": {
        "viewport": { "type": "object", "properties": { "w": { "type": "integer" }, "h": { "type": "integer" } } },
        "gravity": { "type": "number", "description": "px/s² (sidescroller)" },
        "floorY": { "type": "number", "description": "fraction de la hauteur du viewport" },
        "lanes": { "type": "integer", "description": "nombre de couloirs (vertical-arena)" }
      }
    },
    "entities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["role", "rig", "stats"],
        "properties": {
          "role": { "enum": ["hero", "enemy", "boss"] },
          "name": { "type": "string", "description": "nom affiché (barre de boss, dialogues)" },
          "rig": { "type": "string", "description": "chemin du .rig.json (relatif au runtime)" },
          "clips": { "type": "string", "description": "chemin du .clips.json" },
          "scale": { "type": "number", "description": "hauteur cible en fraction du viewport" },
          "stats": {
            "type": "object",
            "properties": {
              "hp": { "type": "number" }, "speed": { "type": "number" },
              "jump": { "type": "number" }, "damage": { "type": "number" },
              "attackRange": { "type": "number" }, "attackCooldown": { "type": "number" },
              "invuln": { "type": "number" }, "touchDamage": { "type": "boolean" }
            }
          },
          "ai": {
            "type": "object",
            "properties": {
              "type": { "enum": ["patrol", "chase", "descend"] },
              "range": { "type": "number" }, "aggroRange": { "type": "number" },
              "chaseSpeed": { "type": "number" }
            }
          }
        }
      }
    },
    "levels": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "arena"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "boss": { "type": "boolean", "description": "niveau boss : victoire = boss vaincu (pas de sortie)" },
          "arena": { "type": "string", "description": "chemin du .parallax.json" },
          "length": { "type": "number", "description": "longueur en px monde (sidescroller)" },
          "spawns": { "type": "array", "items": { "type": "object", "required": ["entity"], "properties": { "entity": { "type": "string" }, "x": { "type": "number" }, "lane": { "type": "integer" }, "t": { "type": "number" } } } },
          "hazards": { "type": "array", "items": { "type": "object", "properties": { "x": { "type": "number" }, "w": { "type": "number" }, "type": { "type": "string" }, "damage": { "type": "number" } } } },
          "pickups": { "type": "array", "items": { "type": "object", "properties": { "x": { "type": "number" }, "py": { "type": "number", "description": "hauteur au-dessus du sol (posé sur plateforme)" }, "type": { "enum": ["heart", "gem"] } } } },
          "platforms": { "type": "array", "description": "plateformes traversantes (verticalité)", "items": { "type": "object", "required": ["x", "w", "y"], "properties": { "x": { "type": "number" }, "w": { "type": "number" }, "y": { "type": "number", "description": "hauteur du dessus au-dessus du sol (px)" } } } },
          "checkpoints": { "type": "array", "items": { "type": "number" } },
          "exit": { "type": "object", "properties": { "x": { "type": "number" } } },
          "waves": { "type": "array", "description": "vertical-arena : vagues programmées", "items": { "type": "object" } }
        }
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "hud": { "type": "array", "items": { "enum": ["hearts", "score", "progress", "wave"] } },
        "accent": { "type": "string" }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "pitch": { "type": "string" },
        "designBackend": { "type": "string", "description": "claude | heuristic — traçabilité de la conception" },
        "generatedAt": { "type": "string" },
        "iterations": { "type": "array", "description": "historique des modifications par prompt", "items": { "type": "object" } }
      }
    }
  },
  "$defs": {
    "beat": {
      "type": "object",
      "required": ["speaker", "text"],
      "properties": { "speaker": { "type": "string" }, "text": { "type": "string" }, "portrait": { "type": "string", "description": "'hero' pour afficher le portrait généré" } }
    }
  }
}
