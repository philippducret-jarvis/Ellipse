{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ellipse.dev/schemas/task-result.json",
  "title": "TaskResult",
  "description": "Résultat retourné par un sous-agent à l'IA maîtresse",
  "type": "object",
  "required": ["task_id", "status", "agent"],
  "properties": {
    "task_id": { "type": "string", "format": "uuid" },
    "agent": { "type": "string" },
    "status": { "enum": ["success", "partial", "failed", "needs_clarification"] },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "path"],
        "properties": {
          "type": {
            "enum": ["sprite", "sprite_sheet", "texture", "model", "audio", "tilemap", "other"]
          },
          "path": { "type": "string" },
          "meta": { "type": "object" }
        }
      }
    },
    "gdl_patches": {
      "type": "array",
      "items": { "type": "object" }
    },
    "agent_notes": { "type": "string" },
    "error": { "type": "string" },
    "recovery_hints": { "type": "array", "items": { "type": "string" } }
  }
}
