{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ellipse.dev/schemas/gdl/game.schema.json",
  "title": "GameDefinitionLanguage",
  "description": "Description déclarative d'un jeu Ellipse — zero-code",
  "type": "object",
  "required": ["meta", "entities", "scenes"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "dimension"],
      "properties": {
        "title": { "type": "string" },
        "dimension": { "enum": ["2d", "3d"] },
        "resolution": {
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 2,
          "maxItems": 2
        },
        "version": { "type": "string", "default": "1.0.0" }
      }
    },
    "style": {
      "type": "object",
      "properties": {
        "palette": { "type": "array", "items": { "type": "string" } },
        "reference_assets": { "type": "array", "items": { "type": "string" } }
      }
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/definitions/Entity" }
    },
    "scenes": {
      "type": "array",
      "items": { "$ref": "#/definitions/Scene" }
    },
    "systems": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ui": { "type": "object" },
    "audio": { "type": "object" }
  },
  "definitions": {
    "Entity": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["character", "enemy", "prop", "trigger", "camera"] },
        "assets": { "type": "object" },
        "components": { "type": "array", "items": { "type": "object" } }
      }
    },
    "Scene": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "tilemap": { "type": "string" },
        "entities": { "type": "array", "items": { "type": "string" } },
        "triggers": { "type": "array", "items": { "type": "object" } },
        "background": { "type": "object" }
      }
    }
  }
}
