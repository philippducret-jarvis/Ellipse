{
  "name": "ellipse",
  "version": "0.1.0",
  "private": true,
  "description": "Moteur de génération de jeux vidéo par IA — zero-code, photo-to-game",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:stack": "turbo run dev --parallel --filter=@ellipse/orchestrator --filter=@ellipse/studio --filter=@ellipse/agents",
    "dev:orchestrator": "pnpm --filter @ellipse/orchestrator dev",
    "dev:studio": "pnpm --filter @ellipse/studio dev",
    "dev:engine": "pnpm --filter @ellipse/engine dev",
    "dev:workers": "pnpm --filter @ellipse/agents dev:workers",
    "dev:pipeline": "pnpm --filter @ellipse/pipeline dev:worker",
    "dev:gateway": "pnpm --filter @ellipse/gateway dev",
    "db:migrate": "pnpm --filter @ellipse/db migrate",
    "orchestrator:plan": "pnpm --filter @ellipse/orchestrator plan",
    "foundation": "pnpm db:migrate && pnpm build",
    "echoes:seed": "node ./tools/seed-echoes-workspace.mjs",
    "shadow:lot01": "node ./tools/build-shadow-echoes-lot01.mjs",
    "shadow:serve": "node ./tools/serve-shadow-echoes.mjs",
    "shadow:test": "node --test ./tools/lib/shadow-echoes/hero-lab.test.mjs ./tools/lib/shadow-echoes/battle.test.mjs ./tools/lib/shadow-echoes/rig-motion.test.mjs ./tools/lib/shadow-echoes/layer-rig.test.mjs ./tools/lib/shadow-echoes/citadel.test.mjs ./tools/lib/shadow-echoes/progression.test.mjs ./tools/lib/shadow-echoes/tactics-rules.test.mjs",
    "shadow:motion": "node ./tools/build-shadow-echoes-motion.mjs",
    "shadow:verify-motion": "node ./tools/verify-shadow-echoes-motion.mjs",
    "shadow:trial": "node ./tools/build-shadow-echoes-trial.mjs",
    "shadow:verify-trial": "node ./tools/verify-shadow-echoes-trial.mjs",
    "shadow:verify": "node ./tools/verify-shadow-echoes-lot01.mjs",
    "echoes:asset-factory": "node ./tools/sync-echoes-asset-factory.mjs",
    "echoes:construction-stack": "node ./tools/sync-echoes-construction-stack.mjs",
    "echoes:systems-board": "node ./tools/sync-echoes-construction-stack.mjs",
    "echoes:operating-model": "node ./tools/sync-echoes-construction-stack.mjs",
    "echoes:production-hq": "node ./tools/sync-echoes-production-hq.mjs",
    "echoes:hero-pack": "node ./tools/build-echoes-hero-pack.mjs",
    "echoes:environment-pack": "node ./tools/build-echoes-environment-pack.mjs",
    "echoes:level-01-pack": "node ./tools/build-echoes-level01-pack.mjs",
    "echoes:validate": "node ./tools/validate-echoes-workspace.mjs",
    "echoes:assets": "node ./tools/generate-echoes-assets.mjs",
    "echoes:hd": "node ./tools/build-echoes-hd.mjs",
    "veloria:create": "node ./tools/create-veloria.mjs",
    "veloria:prep": "node ./tools/build-veloria-prep-pack.mjs",
    "veloria:build": "node ./tools/build-veloria-game.mjs",
    "veloria:assets": "node ./tools/generate-veloria-assets.mjs",
    "veloria:sprint-b": "node ./tools/run-veloria-sprint-b.mjs",
    "veloria:sprints-cde": "node ./tools/run-veloria-sprints-cde.mjs",
    "veloria:agents": "node ./tools/run-veloria-agents.mjs",
    "veloria:all": "node ./tools/build-veloria-pipeline.mjs",
    "veloria:refine-all": "node ./tools/run-veloria-refine-all.mjs",
    "veloria:refine-failed": "node ./tools/run-veloria-refine-failed.mjs",
    "veloria:shipping-pass": "node ./tools/run-veloria-shipping-pass.mjs",
    "veloria:fidelity": "node ./tools/lib/veloria/fidelity-pipeline.mjs",
    "veloria:hd": "node ./tools/build-veloria-hd.mjs",
    "veloria:serve": "node ./tools/serve-veloria-hd.mjs",
    "veloria:verify-hd": "node ./tools/verify-veloria-hd.mjs",
    "veloria:verify-hd:test": "node --test ./tools/verify-veloria-hd.test.mjs",
    "veloria:meta": "node ./tools/build-veloria-meta.mjs",
    "veloria:forge": "node ./tools/build-veloria-forge.mjs",
    "veloria:free": "node ./tools/build-veloria-free-assets.mjs",
    "agents:communication-test": "node ./tools/run-agent-communication-tests.mjs",
    "veloria:seed-studio": "node ./tools/seed-veloria-studio.mjs",
    "roadmap:t0-t3": "node ./tools/run-roadmap-t0-t3.mjs",
    "mechanics:audit": "node ./tools/run-mechanics-audit.mjs",
    "roadmap:revolution": "node ./tools/run-revolutionary-roadmap.mjs",
    "training:assess": "node ./tools/run-training-assess.mjs",
    "training:prep": "node ./tools/run-training-prep.mjs",
    "training:autonomous": "node ./tools/run-autonomous-production.mjs",
    "training:audit": "node ./tools/run-training-audit.mjs",
    "training:all": "node ./tools/run-training-prep.mjs && node ./tools/run-training-assess.mjs && node ./tools/run-autonomous-production.mjs && node ./tools/run-training-audit.mjs",
    "training:cycle": "node ./tools/run-training-cycle.mjs",
    "forge:game": "node ./tools/forge-game.mjs",
    "forge:serve": "node ./tools/serve-forge.mjs",
    "forge:smoke": "node ./tools/forge-smoke.mjs",
    "forge:register": "node ./tools/forge-register.mjs",
    "forge:iterate": "node ./tools/forge-iterate.mjs",
    "forge:gpu-plan": "node ./tools/forge-gpu-plan.mjs",
    "forge:connections": "node ./tools/forge-connections.mjs",
    "forge:screens": "node ./tools/forge-screenshot.mjs",
    "forge:3d": "node ./tools/forge-3d.mjs",
    "forge:chat": "node ./tools/forge-chat.mjs",
    "forge:assistant": "node ./tools/forge-assistant-server.mjs",
    "forge:brain-smoke": "node ./tools/forge-brain-smoke.mjs",
    "ellisphere:sync-agents": "node ./tools/sync-ellisphere-agents.mjs",
    "create:game": "node ./tools/create-game-from-prompt.mjs",
    "create:game:veloria": "node ./tools/deliver-veloria.mjs",
    "orbes:build": "node ./tools/build-orbes-astra.mjs",
    "orbes:serve": "node ./tools/serve-orbes-astra.mjs",
    "orbes:desktop:prepare": "node ./tools/prepare-orbes-desktop.mjs",
    "orbes:desktop": "pnpm orbes:build && pnpm orbes:desktop:prepare && pnpm --filter @ellipse/orbes-astra-desktop build",
    "orbes:v2:prep": "node ./tools/prepare-orbes-v2-preproduction.mjs",
    "orbes:v2:wireframes": "node ./tools/build-orbes-v2-wireframes.mjs",
    "orbes:v2:verify-prep": "node ./tools/verify-orbes-v2-preproduction.mjs",
    "orbes:v2:godot:import": "godot --headless --editor --path ./workspaces/orbes-d-astra/04_runtime/godot --quit",
    "orbes:v2:godot:smoke": "godot --headless --path ./workspaces/orbes-d-astra/04_runtime/godot --quit-after 120",
    "orbes:v2:templates:windows": "node ./tools/install-godot-47-minimal-templates.mjs",
    "orbes:v2:templates:android": "node ./tools/install-godot-47-minimal-templates.mjs --android",
    "orbes:v2:templates:web": "node ./tools/install-godot-47-minimal-templates.mjs --web",
    "orbes:v2:web-mobile": "node ./tools/build-orbes-v2-web-mobile.mjs",
    "orbes:v2:windows": "node ./tools/build-orbes-v2-windows.mjs",
    "orbes:v2:verify-builds": "node ./tools/verify-orbes-v2-builds.mjs",
    "orbes:v2:verify-visuals": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tools/verify-orbes-v2-visual-fidelity.ps1",
    "portfolio:plan": "node ./tools/rebuild-game-portfolio.mjs --dry-run",
    "portfolio:rebuild": "node ./tools/rebuild-game-portfolio.mjs --apply",
    "portfolio:test": "node --test ./tools/rebuild-game-portfolio.test.mjs",
    "deliver:veloria": "node ./tools/deliver-veloria.mjs",
    "mission:complete": "node ./tools/deliver-veloria.mjs",
    "desktop:dev": "pnpm --filter @ellipse/desktop dev",
    "desktop:build": "pnpm --filter @ellipse/desktop build",
    "studio:smoke": "node ./tools/studio-navigation-smoke.mjs",
    "studio:capability-manifest": "node ./tools/sync-studio-capability-manifest.mjs",
    "toolchain:doctor": "node ./tools/setup-free-toolchain.mjs",
    "toolchain:setup": "node ./tools/setup-free-toolchain.mjs --install-winget",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "shadow:layers": "node ./tools/build-shadow-echoes-layers.mjs",
    "shadow:verify-layers": "node ./tools/verify-shadow-echoes-layers.mjs",
    "shadow:citadel": "node ./tools/build-shadow-echoes-citadel.mjs",
    "shadow:verify-edition": "node ./tools/verify-shadow-echoes-edition.mjs",
    "shadow:verify-citadel": "node ./tools/verify-shadow-echoes-citadel.mjs"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "^5.11.0"
    }
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "playwright": "^1.61.1",
    "turbo": "^2.3.3"
  }
}
