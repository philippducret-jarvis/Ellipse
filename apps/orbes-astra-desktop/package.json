{
  "name": "@ellipse/orbes-astra-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Orbes d'Astra — jeu autonome Windows",
  "main": "electron-main.mjs",
  "type": "module",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "games.ellipse.orbesastra",
    "productName": "Orbes d'Astra",
    "artifactName": "Orbes-d-Astra-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": ["portable"],
      "icon": "game/assets/app-icon-512.png",
      "signAndEditExecutable": false
    },
    "files": [
      "electron-main.mjs",
      "game/**/*"
    ],
    "asar": true,
    "npmRebuild": false
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  }
}
