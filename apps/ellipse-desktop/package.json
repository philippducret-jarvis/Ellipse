{
  "name": "@ellipse/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Ellipse Studio — application desktop Windows",
  "main": "electron-main.mjs",
  "type": "module",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.ellipse.studio",
    "productName": "Ellipse Studio",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis"],
      "icon": "assets/ellipse-app.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Ellipse Studio"
    },
    "files": [
      "electron-main.mjs",
      "assets/**/*"
    ],
    "extraMetadata": {
      "main": "electron-main.mjs"
    }
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  }
}
