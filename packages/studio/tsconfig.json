{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/components/AgentTimeline.tsx",
    "src/components/PlanSummary.tsx",
    "src/components/PromptPanel.tsx",
    "src/components/SessionHistory.tsx",
    "src/components/Sidebar.tsx",
    "src/components/WorkOfferingsPanel.tsx",
    "src/views/AgentsCatalogView.tsx",
    "src/views/CreateView.tsx",
    "src/views/FactoryView.tsx",
    "src/views/HistoryView.tsx"
  ]
}
